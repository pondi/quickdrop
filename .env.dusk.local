QUICKDROP_REFERENCE_REQUIRED=true
QUICKDROP_REFERENCE_PATTERN="^[A-Za-z0-9-]{3,50}$"
QUICKDROP_REFERENCE_MIN_LENGTH=3
QUICKDROP_REFERENCE_MAX_LENGTH=50
QUICKDROP_REFERENCE_ERROR_MESSAGE="Reference number must be 3-50 characters long and can only contain letters, numbers, and hyphens."
